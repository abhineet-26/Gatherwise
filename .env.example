# GatherWise environment. Copy to `.env` for local runs. NEVER commit `.env`.
# Every value below is a placeholder; the app boots with all of them blank.

# --- Server ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Gemini (server-side only; leave GEMINI_API_KEY blank to run without AI) ---
# Create a key in Google AI Studio ("Get API key"). Never prefix it with VITE_.
GEMINI_API_KEY=
# Model ids change often: confirm at https://ai.google.dev/gemini-api/docs/models
# (values below were the documented stable ids on 2026-10-19)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
AI_ENABLED=true
AI_RATE_LIMIT_PER_MIN=12
AI_DAILY_REQUEST_CAP=400

# --- Weather (Open-Meteo: no key; free tier is for non-commercial use) ---
WEATHER_ENABLED=true

# --- HTTP ---
# Comma-separated extra origins allowed by CORS (empty = same-origin only)
ALLOWED_ORIGINS=
# Set true ONLY in an environment that must iframe the app (e.g. an IDE preview)
ALLOW_EMBEDDING=false

# --- Cloud mode (optional: Firebase Auth + Firestore) ---
FIREBASE_PROJECT_ID=
# Path to a service-account JSON kept OUTSIDE the repository, or use platform default credentials:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/service-account.json

# --- Client (Vite exposes VITE_* to the browser: public values only, never secrets) ---
VITE_STORAGE_MODE=local
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
